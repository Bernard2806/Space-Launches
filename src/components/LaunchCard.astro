---
import type { Launch } from '../services/launches';
import { statusLabel, statusBadgeClass, formatLaunchDate } from '../services/launches';

interface Props {
	launch: Launch;
}

const { launch } = Astro.props;

const statusEs = statusLabel(launch.status);
const dateEs = formatLaunchDate(launch.date);
const badge = statusBadgeClass(launch.status);
const name = launch.name ?? 'Lanzamiento sin título';
const hasImage = Boolean(launch.image);
const searchName = (name + ' ' + (launch.agency ?? '')).toLowerCase();
---

<article
	class="launch-card group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-sky-400/40 hover:shadow-[0_0_40px_-12px_rgba(56,189,248,0.55)]"
	data-name={searchName}
	data-agency={(launch.agency ?? '').toLowerCase()}
	data-status={launch.status ?? ''}
	data-date={launch.date ?? ''}
	data-score={launch.score}
>
	<div class="relative h-48 w-full overflow-hidden bg-slate-900">
		{
			hasImage ? (
				<img
					src={launch.image}
					alt={name}
					loading="lazy"
					class="h-full w-full object-cover opacity-90 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
				/>
			) : (
				<div class="h-full w-full bg-gradient-to-br from-slate-800 via-slate-900 to-black" />
			)
		}
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

		<div class="absolute right-3 top-3 flex flex-col items-end gap-2">
			<span class={`rounded-full border px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide ${badge}`}>
				{statusEs}
			</span>
			{
				launch.webcast && (
					<span class="flex items-center gap-1.5 rounded-full border border-rose-500/30 bg-rose-500/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-rose-300">
						<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-400"></span>
						Webcast
					</span>
				)
			}
		</div>

		<div class="absolute bottom-3 left-4 right-4">
			<h3 class="text-lg font-bold leading-tight text-white drop-shadow line-clamp-2">{name}</h3>
		</div>
	</div>

	<div class="flex flex-1 flex-col gap-3 p-4">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-300">
			{launch.agency && (
				<span class="inline-flex items-center gap-1.5">
					<svg class="h-3.5 w-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
					{launch.agency}
				</span>
			)}
			{launch.rocket && (
				<span class="inline-flex items-center gap-1.5">
					<svg class="h-3.5 w-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c3 2 5 6 5 10l-3 3H10l-3-3c0-4 2-8 5-10zM12 15v7M9 22h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
					{launch.rocket}
				</span>
			)}
		</div>

		{launch.location && (
			<p class="flex items-center gap-1.5 text-sm text-slate-400">
				<svg class="h-3.5 w-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-12a7 7 0 1114 0c0 5.5-7 12-7 12z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="9" r="2.5"/></svg>
				{launch.location}{launch.pad ? ` · ${launch.pad}` : ''}
			</p>
		)}

		<p class="flex items-center gap-1.5 text-sm font-medium text-slate-200">
			<svg class="h-3.5 w-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4" stroke-linecap="round"/></svg>
			{dateEs}
		</p>

		{launch.mission && (
			<p class="line-clamp-3 text-sm leading-relaxed text-slate-400">{launch.mission}</p>
		)}

		{
			launch.missionTypes?.length > 0 && (
				<div class="mt-auto flex flex-wrap gap-1.5 pt-1">
					{launch.missionTypes.map((t) => (
						<span class="rounded-md bg-white/5 px-2 py-0.5 text-[11px] font-medium text-slate-300">
							{t}
						</span>
					))}
				</div>
			)
		}

		{launch.url && (
			<a
				href={launch.url}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-300 transition hover:text-sky-200"
			>
				Ver detalles en The Space Devs
				<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</a>
		)}
	</div>
</article>
