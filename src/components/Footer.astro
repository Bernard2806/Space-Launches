---
import type { ApodData } from '../services/apod';

interface Props {
	apod: ApodData;
}

const { apod } = Astro.props;
const copyrightHolder = apod.copyright || 'NASA';
---

<footer class="w-full bg-black/90 border-t border-white/10 text-slate-300 py-3.5 px-4 sm:px-6 relative z-20">
	<div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs">
		<!-- Datos de la imagen de la NASA -->
		<div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1 text-center sm:text-left">
			<span class="text-sky-400 font-semibold">NASA APOD:</span>
			<a
				href="https://apod.nasa.gov/apod/astropix.html"
				target="_blank"
				rel="noopener noreferrer"
				class="text-white hover:text-sky-300 underline underline-offset-2 transition-colors font-medium"
			>
				"{apod.title}"
			</a>
			<span class="text-slate-500">•</span>
			<span class="text-slate-400">© {copyrightHolder}</span>
			<span class="text-slate-500">•</span>
			<span class="text-slate-400">{apod.date}</span>
		</div>

		<!-- Firma de la app -->
		<div class="text-slate-400 text-[11px] text-center sm:text-right shrink-0">
			<span>Space Launches</span>
		</div>
	</div>
</footer>
