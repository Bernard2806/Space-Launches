---
import type { ApodData } from '../services/apod';

interface Props {
	apod: ApodData;
}

const { apod } = Astro.props;
const currentYear = new Date().getFullYear();
const copyrightHolder = apod.copyright || 'NASA / Colaboradores de APOD';
---

<footer class="w-full bg-black/90 border-t border-white/10 backdrop-blur-2xl text-slate-300 relative z-20 overflow-hidden">
	<!-- Línea de brillo cósmico superior -->
	<div class="h-[1px] w-full bg-gradient-to-r from-transparent via-sky-500/50 to-transparent"></div>

	<div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-8">
		<!-- Bloque Principal de Copyright y Atribución Legal (Mobile-First) -->
		<div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
			<!-- Columna 1: Marca & Misión -->
			<div class="md:col-span-5 space-y-3">
				<div class="flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-gradient-to-br from-sky-400 to-indigo-600 flex items-center justify-center text-sm shadow-md shadow-sky-500/30">
						🚀
					</div>
					<span class="font-extrabold text-lg text-white tracking-tight">Space Launches</span>
				</div>
				<p class="text-xs text-slate-400 leading-relaxed">
					Plataforma de seguimiento en tiempo real de misiones y lanzamientos espaciales globales. Una experiencia cósmica impulsada por datos abiertos.
				</p>
			</div>

			<!-- Columna 2: Atribución de Derechos de la Imagen Diaria (NASA APOD) -->
			<div class="md:col-span-7 bg-white/[0.03] border border-white/10 rounded-2xl p-4 sm:p-5 space-y-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex items-center gap-2">
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-500/10 text-sky-400 border border-sky-500/20 uppercase tracking-wider">
							Créditos de la Imagen Diaria
						</span>
						<span class="text-[11px] text-slate-400">📅 {apod.date}</span>
					</div>
					<a
						href="https://apod.nasa.gov/apod/astropix.html"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1 text-[11px] font-semibold text-sky-400 hover:text-sky-300 hover:underline transition-colors"
					>
						NASA APOD Oficial
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
						</svg>
					</a>
				</div>

				<div class="space-y-1">
					<p class="text-xs text-white font-semibold flex flex-wrap items-center gap-1.5">
						<span>Obra:</span>
						<span class="text-sky-300 font-medium">"{apod.title}"</span>
					</p>
					<p class="text-xs text-slate-300 flex flex-wrap items-center gap-1.5">
						<span class="text-slate-400 font-normal">Copyright / Autor:</span>
						<span class="font-semibold text-white">© {copyrightHolder}</span>
					</p>
				</div>

				<p class="text-[11px] text-slate-400 leading-normal border-t border-white/5 pt-2.5">
					<strong class="text-slate-300">Aviso legal de derechos:</strong> Las imágenes astronómicas mostradas como fondo dinámico pertenecen a sus respectivos autores, fotógrafos o a la NASA. Son presentadas respetando las directrices de difusión educativa de NASA APOD sin fines comerciales.
				</p>
			</div>
		</div>

		<!-- Línea divisoria y Copyright de la Web -->
		<div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 text-center sm:text-left">
			<p>© {currentYear} Space Launches. Todos los derechos reservados.</p>
			
			<div class="flex flex-wrap items-center justify-center gap-3 text-[11px]">
				<span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/5 text-slate-300">
					Astro & Tailwind CSS
				</span>
				<span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/5 text-slate-300">
					NASA Open API / APOD
				</span>
			</div>
		</div>
	</div>
</footer>
