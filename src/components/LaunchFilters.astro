---
interface Props {
	agencies: string[];
	statuses: { value: string; label: string }[];
}

const { agencies, statuses } = Astro.props;
---

<div class="sticky top-4 z-20 mb-8 rounded-2xl border border-white/10 bg-black/40 p-4 backdrop-blur-md">
	<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto]">
		<div class="relative">
			<svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4" stroke-linecap="round"/></svg>
			<input
				id="search"
				type="search"
				placeholder="Buscar lanzamiento o agencia…"
				class="w-full rounded-xl border border-white/10 bg-white/5 py-2.5 pl-10 pr-3 text-sm text-slate-100 placeholder:text-slate-500 outline-none transition focus:border-sky-400/50 focus:ring-2 focus:ring-sky-400/20"
			/>
		</div>

		<select id="filter-agency" class="rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-sky-400/50 focus:ring-2 focus:ring-sky-400/20">
			<option value="">Todas las agencias</option>
			{agencies.map((a) => <option value={a.toLowerCase()}>{a}</option>)}
		</select>

		<select id="filter-status" class="rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-sky-400/50 focus:ring-2 focus:ring-sky-400/20">
			<option value="">Todos los estados</option>
			{statuses.map((s) => <option value={s.value}>{s.label}</option>)}
		</select>

		<select id="sort" class="rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-slate-100 outline-none transition focus:border-sky-400/50 focus:ring-2 focus:ring-sky-400/20">
			<option value="date-asc">Fecha más cercana</option>
			<option value="score">Mejor puntuación</option>
			<option value="date-desc">Fecha más lejana</option>
		</select>
	</div>

	<p class="mt-3 text-xs text-slate-400">
		Mostrando <span id="result-count" class="font-semibold text-slate-200">0 lanzamientos</span>
	</p>
</div>

<p id="no-results" hidden class="rounded-xl border border-white/10 bg-white/5 p-6 text-center text-slate-400">
	No se encontraron lanzamientos con esos filtros.
</p>
