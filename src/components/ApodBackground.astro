---
import type { ApodData } from '../services/apod';

interface Props {
	apod: ApodData;
}

const { apod } = Astro.props;
const backgroundUrl = apod.hdImageUrl || apod.imageUrl;
---

<div id="apod-container" class="fixed inset-0 -z-50 overflow-hidden pointer-events-none select-none">
	<!-- Imagen de fondo de la NASA -->
	<div
		id="apod-bg-image"
		class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700"
		style={`background-image: url('${backgroundUrl}');`}
		aria-hidden="true"
	>
	</div>

	<!-- Desenfoque mínimo y oscurecimiento sutil -->
	<div class="absolute inset-0 backdrop-blur-[2px] bg-black/35"></div>
	<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30"></div>
</div>
