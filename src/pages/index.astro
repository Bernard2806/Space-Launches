---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Space Launches | Lanzamientos Espaciales">
	<main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 py-12 text-center max-w-4xl mx-auto">
		<div class="space-y-6">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-sky-300 text-xs sm:text-sm font-medium backdrop-blur-sm shadow-sm">
				<span>🚀 Lanzamientos Espaciales en Vivo</span>
			</div>

			<h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white drop-shadow-md">
				Space <span class="text-sky-400">Launches</span>
			</h1>

			<p class="text-base sm:text-lg text-slate-200/90 max-w-xl mx-auto font-normal leading-relaxed drop-shadow">
				Seguimiento en tiempo real de misiones y lanzamientos espaciales de todo el mundo.
			</p>
		</div>
	</main>
</Layout>
